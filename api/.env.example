# Hadi Education System — Environment Variables
# Copy this file to .env and fill in real values

# Base URL configuration (Default: http://localhost:3000)
# TODO: When domain is active, change to https://www.hes.com.pk
SITE_URL=http://localhost:3000

# Admissions Notification Inbox (Destination email)
ADMISSIONS_EMAIL=admissions@hes.com.pk

# Resend API Key (get from https://resend.com - works without a custom domain initially using onboarding@resend.dev)
RESEND_API_KEY=re_test_placeholder_key

# Cloudflare Turnstile CAPTCHA Keys
# Testing keys documentation: https://developers.cloudflare.com/turnstile/reference/testing/
# Test Site Key (always passes):
TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Test Secret Key (always passes):
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Privacy-first Cookieless Analytics Configuration
# Options: 'none' | 'plausible' | 'umami'
ANALYTICS_PROVIDER=none
ANALYTICS_SITE_ID=
ANALYTICS_URL=
